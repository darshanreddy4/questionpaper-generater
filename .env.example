# Copy to .env (git-ignored) on each machine. Without it the app runs in single-school mode,
# where the login page only offers "Sign in" and "Create account".
EXAMFORGE_TENANCY=multi
EXAMFORGE_SUPERADMIN_EMAILS=operator@example.com

# Fixed values keep sessions and stored AI keys valid across restarts (generate your own).
# EXAMFORGE_SECRET_KEY=
# EXAMFORGE_ENCRYPTION_KEY=

# Optional platform-wide AI key and prices
# OPENAI_API_KEY=
# EXAMFORGE_PRICE_INPUT_PER_M=3
# EXAMFORGE_PRICE_OUTPUT_PER_M=15
# EXAMFORGE_PLATFORM_FEE_MONTHLY=10
